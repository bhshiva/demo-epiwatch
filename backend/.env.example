DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/epiwatch
CORS_ORIGINS=http://localhost:8080,http://localhost:5000,http://127.0.0.1:8080,http://127.0.0.1:5000
JWT_SECRET=change-this-to-a-random-64-char-string
# pgcrypto symmetric key for column-level PII/clinical-text encryption
# (app/services/crypto.py). Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Losing this key makes the encrypted columns permanently unrecoverable --
# back it up outside of source control, the same as JWT_SECRET.
PGCRYPTO_KEY=change-this-to-a-random-key
REDIS_URL=redis://localhost:6379/0

# Neo4j: the strain/isolate/antibiotic/facility/pathogen relationship graph
# (app/services/graph_db.py, scripts/sync_neo4j_graph.py). Postgres stays
# the system of record; this is a periodically-refreshed derived view,
# browsable via Neo4j Browser at http://localhost:7474.
#
# Local dev via Docker:
#   docker run -d --name epiwatch-neo4j -p 7474:7474 -p 7687:7687 \
#     -e NEO4J_AUTH=neo4j/<password> neo4j:5-community
# Or point NEO4J_URI/NEO4J_USER/NEO4J_PASSWORD at a native Neo4j
# Desktop/Server install instead -- nothing else in this project needs to
# change either way, this is the only place the connection is configured.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-to-a-random-password

# ABDM (Ayushman Bharat Digital Mission) ABHA verification.
# Leave blank to run offline: ABHA numbers are still format- and
# checksum-validated locally, they just are not confirmed against the registry.
#
# Local mock gateway (uvicorn mock_abdm.server:app --port 8010):
#   ABDM_BASE_URL=http://localhost:8010/abha/api
#   ABDM_GATEWAY_URL=http://localhost:8010/gateway
#
# NHA sandbox, once credentials are issued:
#   ABDM_BASE_URL=https://abhasbx.abdm.gov.in/abha/api
#   ABDM_GATEWAY_URL=https://dev.abdm.gov.in/api/hiecm/gateway
ABDM_BASE_URL=
ABDM_GATEWAY_URL=
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_CM_ID=sbx
